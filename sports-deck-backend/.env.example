# Copy to .env for local development, or set each variable in the Vercel
# dashboard (Project -> Settings -> Environment Variables) for production.
# Never commit real values.

# PostgreSQL connection string. On Neon, use the *pooled* connection string.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Redis connection string. On Upstash, use the rediss:// (TLS) URL.
REDIS_URL="rediss://default:password@host:6379"

# Long random strings, e.g. generated with: openssl rand -hex 32
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# football-data.org API key (https://www.football-data.org/client/register)
MATCH_API_KEY=""

# Hugging Face access token (https://huggingface.co/settings/tokens)
HF_TOKEN=""

# GitHub OAuth app (https://github.com/settings/developers)
# Callback URL: https://<your-domain>/auth/callback
NEXT_PUBLIC_GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Admin account created by `npm run db:seed` (only needed when seeding)
ADMIN_EMAIL=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
