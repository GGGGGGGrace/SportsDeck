// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum MatchStatus {
  SCHEDULED
  TIMED
  FINISHED
  POSTPONED
  CANCELLED
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String   @unique
  password     String
  username     String?  @unique
  avatarUrl    String?
  favoriteTeam String?
  role         UserRole   @default(USER)
  banned       Boolean  @default(false)
  createdAt    DateTime @default(now())

  threads   Thread[]
  posts     Post[]
  replies   Reply[]
  followers Follow[] @relation("FollowTarget")
  following Follow[] @relation("FollowInitiator")
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  follower  User @relation("FollowInitiator", fields: [followerId], references: [id])
  following User @relation("FollowTarget", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Match {
  id            String      @id @default(uuid()) @db.Uuid
  externalId    Int      @unique
  homeTeam      String
  awayTeam      String
  homeTeamCrest String?
  awayTeamCrest String?
  homeScore     Int?
  awayScore     Int?
  score         String?
  status        MatchStatus
  matchday      Int      @default(0)
  matchDate     DateTime
  venue         String?
  stage         String?
  updatedAt     DateTime @default(now()) @updatedAt

  threads Thread[]
}

model Team {
  id        Int      @id
  name      String
  shortName String?
  tla       String?
  crest     String?
  venue     String?
  updatedAt DateTime @default(now()) @updatedAt
}

model ApiCache {
  key       String   @id
  data      Json
  expiresAt DateTime
  updatedAt DateTime @default(now()) @updatedAt
}

model Thread {
  id        Int      @id @default(autoincrement())
  title     String
  authorId  String   @db.Uuid
  teamId    Int?
  matchId   String?  @db.Uuid
  match     Match?   @relation(fields: [matchId], references: [id])
  hidden    Boolean  @default(false)
  sentimentLabel String?
  sentimentScore Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])

  posts   Post[]
  tags    ThreadTag[]
  polls   Poll[]
  reports Report[]
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  threadId  Int
  authorId  String   @db.Uuid
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hidden    Boolean  @default(false)

  aiModerationLabel String?
  aiModerationScore Float?
  aiModerationReason String? @db.Text
  translatedText    String?

  thread Thread @relation(fields: [threadId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  replies Reply[]
  reports Report[]
}

model Reply {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  postId    Int
  authorId  String   @db.Uuid
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id])
  author User @relation(fields: [authorId], references: [id])
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique

  threads ThreadTag[]
}

model ThreadTag {
  threadId Int
  tagId    Int

  thread Thread @relation(fields: [threadId], references: [id])
  tag    Tag    @relation(fields: [tagId], references: [id])

  @@id([threadId, tagId])
}

model Poll {
  id       Int      @id @default(autoincrement())
  threadId Int
  question String
  deadline DateTime

  thread  Thread       @relation(fields: [threadId], references: [id])
  options PollOption[]
}

model PollOption {
  id     Int    @id @default(autoincrement())
  pollId Int
  text   String

  poll  Poll       @relation(fields: [pollId], references: [id])
  votes PollVote[]
}

model PollVote {
  id       Int    @id @default(autoincrement())
  optionId Int
  userId   String @db.Uuid

  option PollOption @relation(fields: [optionId], references: [id])
}

model Report {
  id         Int      @id @default(autoincrement())
  reporterId String       @db.Uuid
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime @default(now())

  postId   Int?
  threadId Int?

  aiLabel  String?
  aiScore  Float?
  aiReason String? @db.Text

  post   Post?   @relation(fields: [postId], references: [id])
  thread Thread? @relation(fields: [threadId], references: [id])
}

model Appeal {
  id        Int      @id @default(autoincrement())
  userId    String   @db.Uuid
  reason    String
  status    AppealStatus @default(PENDING)
  createdAt DateTime @default(now())
}

model Digest {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now())
}