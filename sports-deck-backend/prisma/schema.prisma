// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  username     String?  @unique
  avatarUrl    String?
  favoriteTeam String?
  role         String   @default("USER")
  createdAt    DateTime @default(now())

  threads Thread[]
  posts   Post[]
  replies Reply[]
}

model Match {
  id            String   @id @default(cuid())
  externalId    Int      @unique
  homeTeam      String
  awayTeam      String
  homeTeamCrest String?
  awayTeamCrest String?
  homeScore     Int?
  awayScore     Int?
  score         String?
  status        String
  matchday      Int      @default(0)
  matchDate     DateTime
  venue         String?
  stage         String?
  group         String?
  updatedAt     DateTime @default(now()) @updatedAt

  threads Thread[]
}

model Team {
  id        Int      @id
  name      String
  shortName String?
  tla       String?
  crest     String?
  venue     String?
  updatedAt DateTime @default(now()) @updatedAt
}

model ApiCache {
  key       String   @id
  data      String
  expiresAt DateTime
  updatedAt DateTime @default(now()) @updatedAt
}

model Thread {
  id        Int      @id @default(autoincrement())
  title     String
  authorId  String
  teamId    Int?
  matchId   String?
  match     Match?   @relation(fields: [matchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])

  posts Post[]
  tags  ThreadTag[]
  polls Poll[]
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String
  threadId  Int
  authorId  String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread Thread @relation(fields: [threadId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  replies Reply[]
}

model Reply {
  id        Int      @id @default(autoincrement())
  content   String
  postId    Int
  authorId  String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id])
  author User @relation(fields: [authorId], references: [id])
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique

  threads ThreadTag[]
}

model ThreadTag {
  threadId Int
  tagId    Int

  thread Thread @relation(fields: [threadId], references: [id])
  tag    Tag    @relation(fields: [tagId], references: [id])

  @@id([threadId, tagId])
}

model Poll {
  id       Int      @id @default(autoincrement())
  threadId Int
  question String
  deadline DateTime

  thread  Thread       @relation(fields: [threadId], references: [id])
  options PollOption[]
}

model PollOption {
  id     Int    @id @default(autoincrement())
  pollId Int
  text   String

  poll  Poll       @relation(fields: [pollId], references: [id])
  votes PollVote[]
}

model PollVote {
  id       Int    @id @default(autoincrement())
  optionId Int
  userId   String

  option PollOption @relation(fields: [optionId], references: [id])
}
